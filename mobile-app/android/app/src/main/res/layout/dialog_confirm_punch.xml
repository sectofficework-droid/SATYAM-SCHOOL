<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_dialog_check_circle">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_check_white_24" />
    </FrameLayout>

    <TextView
        android:id="@+id/dialog_employee_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:textColor="@color/brand_navy"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:ignore="HardcodedText"
        tools:text="Employee Name" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Punch in as this person?"
        android:textColor="@color/brand_amber"
        android:textSize="14sp" />
</LinearLayout>
